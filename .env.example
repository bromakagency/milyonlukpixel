# ==============================================
# MILYONLUK PIXEL — Ortam Değişkenleri Şablonu
# ==============================================
# Bu dosyayı .env olarak kopyalayın ve gerçek değerleri girin.

# --- Sunucu ---
PORT=3001
NODE_ENV=development

# --- Supabase (Frontend - Vite) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_key"

# --- Supabase (Backend - Express) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# --- Email Bildirimleri (Resend) ---
RESEND_API_KEY="re_your_resend_api_key"
ADMIN_EMAIL="admin@example.com"
FROM_EMAIL="Milyonluk Pixel <noreply@milyonlukpiksel.com>"

# --- Cloudflare R2 Dosya Depolama ---
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_bucket_name"
R2_PUBLIC_URL="https://cdn.milyonlukpiksel.com"

# --- PayTR Ödeme Entegrasyonu ---
PAYTR_MERCHANT_ID="your_paytr_merchant_id"
PAYTR_MERCHANT_KEY="your_paytr_merchant_key"
PAYTR_MERCHANT_SALT="your_paytr_merchant_salt"
PAYTR_MERCHANT_OK_URL="https://milyonlukpiksel.com/basarili"
PAYTR_MERCHANT_FAIL_URL="https://milyonlukpiksel.com/hata"
PAYTR_TEST_MODE="1"
PAYTR_DEBUG_ON="1"
