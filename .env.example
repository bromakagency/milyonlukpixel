# ==============================================
# MILYONLUK PIXEL — Ortam Değişkenleri Şablonu
# ==============================================
# Bu dosyayı .env olarak kopyalayın ve gerçek değerleri girin.

# --- Sunucu ---
PORT=3001
NODE_ENV=development

# --- Supabase (Frontend - Vite) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_key"

# --- Supabase (Backend - Express) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# --- Email Bildirimleri (Resend) ---
RESEND_API_KEY="re_your_resend_api_key"
ADMIN_EMAIL="admin@example.com"
FROM_EMAIL="Milyonluk Pixel <noreply@milyonlukpiksel.com>"
